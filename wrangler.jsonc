{
  // SealGuard: the page (built by Vite into dist/), the /rpc relay and the guard (D1 + cron) on one Worker.
  //   guard.2cstudio.app
  // Secrets (`npx wrangler secret put <NAME>`):
  //   RPC_URL             Helius URL with key (DAS-capable)
  //   SESSION_SECRET      random 32+ chars; signs sign-in nonces and session tokens
  //   TELEGRAM_BOT_TOKEN  the alert bot's token from @BotFather (optional until the guard launches)
  // D1: `npx wrangler d1 create sealguard` once, paste the id below, then `npx wrangler d1 migrations apply sealguard --remote`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sealguard",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "workers_dev": false,
  "routes": [
    { "pattern": "guard.2cstudio.app", "custom_domain": true }
  ],
  "assets": { "directory": "dist", "binding": "ASSETS", "run_worker_first": ["/rpc", "/health", "/api/*", "/mcp"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "sealguard", "database_id": "17eb9995-918a-45fd-8736-061ce285d05b", "migrations_dir": "migrations" }
  ],
  // Every 10 minutes: re-scan the guards whose turn it is (each active wallet about once an hour).
  "triggers": { "crons": ["*/10 * * * *"] },
  // Rate limits per caller (Workers Rate Limiting; period is 10 or 60 s). RL_RPC: the /rpc relay to Helius;
  // RL_API: /api/stat, sign-in, price quotes and Telegram replies.
  "ratelimits": [
    { "name": "RL_RPC", "namespace_id": "1101", "simple": { "limit": 300, "period": 60 } },
    { "name": "RL_API", "namespace_id": "1102", "simple": { "limit": 40, "period": 60 } }
  ],
  "vars": {
    "PUBLIC_URL": "https://guard.2cstudio.app",
    // 2C Studio's treasury wallet (the same one SealDraw and BananaTap collect into).
    "TREASURY": "B3BCTvv1LUpXZ2PpB4HeppxuSsS8Y1GSjYYG6NB6xTUA",
    // The alert bot's @username without the @ (set once the bot exists).
    "TELEGRAM_BOT_USERNAME": "seal_guard_bot"
  }
}
